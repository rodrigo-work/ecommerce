{
  "folders": [
    {
      "name": "ecommerce",
      "path": "../",
    },
    {
      "name": "web",
      "path": "../apps/web",
    },
    {
      "name": "typescript-config",
      "path": "../packages/typescript-config",
    },
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit",
    },
    "eslint.workingDirectories": [
      {
        "mode": "auto",
      },
    ],
    "files.exclude": {
      "*": false,
    },
  },
}
